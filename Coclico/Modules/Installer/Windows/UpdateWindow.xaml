<ui:FluentWindow x:Class="Coclico.Modules.Installer.Windows.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Mise à jour Coclico"
        Width="560" SizeToContent="Height" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource BgBaseBrush}">

    <Border Padding="24,20">
        <StackPanel>

            <!-- En-tête : icône + versions -->
            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource BgElevatedBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" VerticalAlignment="Top">
                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="20" Foreground="{DynamicResource ArchitecturalYellowBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Une nouvelle version de Coclico est disponible" FontSize="14.5" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="VersionLine" Text="" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Notes de version -->
            <TextBlock Text="NOTES DE VERSION" FontSize="9.5" FontWeight="Bold"
                       Foreground="{DynamicResource TextHintBrush}" Margin="0,12,0,6"/>
            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource CornerCard}" Padding="14,10" MaxHeight="230">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="NotesText" Text="" FontSize="11" LineHeight="16"
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

            <!-- Progression et statut -->
            <ProgressBar x:Name="DownloadProgress" Height="6" BorderThickness="0" Margin="0,14,0,0"
                         Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"
                         Background="{DynamicResource BgElevatedBrush}" Foreground="{DynamicResource PrimaryBrush}"/>
            <TextBlock x:Name="StatusText" Text="Le téléchargement est vérifié par SHA-256 avant l'installation."
                       FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>

            <!-- Boutons -->
            <Grid Margin="0,16,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnSkip" Grid.Column="0" Content="Ignorer cette version" Click="BtnSkip_Click"
                        FontSize="11" Padding="10,6" Cursor="Hand" HorizontalAlignment="Left"
                        Background="Transparent" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                        Foreground="{DynamicResource TextMutedBrush}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="7"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnLater" Grid.Column="1" Content="Plus tard" Click="BtnLater_Click"
                        FontSize="11.5" Padding="14,7" Margin="0,0,8,0" Cursor="Hand"
                        Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnInstall" Grid.Column="2" Content="Télécharger et installer" Click="BtnInstall_Click"
                        FontSize="11.5" FontWeight="SemiBold" Padding="16,8" Cursor="Hand"
                        Background="{DynamicResource PrimaryBrush}" Foreground="White">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</ui:FluentWindow>
