<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <!-- Restaure les cibles Windows même depuis un agent Linux (soumission automatique des dépendances GitHub). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\icone\plage.ico</ApplicationIcon>
    <!-- La version est centralisée dans version.txt à la racine (voir Directory.Build.props). -->
    <Company>Coclico</Company>
    <Product>Coclico</Product>
    <Description>Windows desktop application for system information and maintenance tools.</Description>
    <Copyright>© $([System.DateTime]::UtcNow.Year) Coclico</Copyright>
    <NeutralLanguage>en</NeutralLanguage>

    <!-- Ne publier que les ressources linguistiques réellement utilisées (l'interface gère fr/en) -->
    <SatelliteResourceLanguages>fr;en</SatelliteResourceLanguages>

    <!-- .NET 10 Performance Optimizations -->
    <TieredPGO>true</TieredPGO>
    <TieredCompilation>true</TieredCompilation>
    <OptimizationPreference>Speed</OptimizationPreference>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- Security Hardening: portable PDBs are shipped even in Release on purpose —
         they carry source-line info for the crash/error NDJSON reports. -->
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- Code Analysis -->
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\icone\plage.ico" />
    <Resource Include="Resources\icone\plage.png" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Coclico.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Core Framework -->
    <PackageReference Include="LLamaSharp" Version="0.26.0" />
    <!-- GPU CUDA 12 Backend (NVIDIA RTX / GTX) with automatic CPU fallback -->
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.26.0" />
    <PackageReference Include="NtvLibs.cuda12.cudart64_12.runtime.win-x64" Version="12.8.1" />
    <PackageReference Include="NtvLibs.cuda12.cublas.runtime.win-x64" Version="12.8.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

    <!-- Logging -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />

    <!-- System & Hardware -->
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />

    <!-- Reactive Extensions -->
    <PackageReference Include="System.Reactive" Version="6.0.1" />

    <!-- UI -->
    <PackageReference Include="WPF-UI" Version="4.2.0" />

    <!-- Serialization — System.Text.Json is included natively in .NET 10, no explicit ref needed -->

  </ItemGroup>

  <Target Name="RemoveNonWindowsRuntimeAssetsFromWindowsPublish"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <RemoveDir Directories="$(PublishDir)runtimes\linux-x64" />
  </Target>

</Project>
